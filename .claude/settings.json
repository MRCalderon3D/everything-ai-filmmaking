{
  "$generated": "GENERATED by scripts/sync-harnesses.js — do not edit",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/protect-approved-assets.js"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/require-cost-confirmation.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/validate-after-write.js"
          },
          {
            "type": "command",
            "command": "node hooks/detect-continuity-drift.js"
          }
        ]
      }
    ]
  }
}
